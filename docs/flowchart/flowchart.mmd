%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 22, "rankSpacing": 55, "padding": 12, "subGraphTitleMargin": {"top": 6, "bottom": 14}}, "themeVariables": {"fontFamily": "Arial", "fontSize": "18px", "primaryColor": "#eef4fb", "primaryBorderColor": "#4a6f96", "primaryTextColor": "#1d2b3a", "lineColor": "#5b6f84", "clusterBkg": "#f7f9fc", "clusterBorder": "#9fb3c8", "edgeLabelBackground": "#ffffff"}}}%%
flowchart LR
  MON["<b>12 bedside monitors</b><br/>MON-01..12, simulator replaying real<br/>PhysioNet / MIMIC-III / VitalDB recordings<br/>1 reading per bed per second, 125 Hz"]
  ATK["Attacker (red-team test)<br/>replay · fake flatline · flood · forged drift"]

  subgraph Z["IBM LinuxONE z17 (Telum II NNPA) · s390x · containers"]
    direction LR
    HUB["<b>Secured MQTT hub</b><br/>Mosquitto + Dynamic Security<br/>TLS 1.3 on 8883<br/>per-device accounts, deny-by-default ACLs"]
    NW["Network witness<br/>(extractor, sw-net)<br/>reads broker log<br/>features per device / 5 s"]

    subgraph BR["Brain: six checks every 5 s"]
      direction LR
      M1["M1 sensor usable?"]
      M2["M2 real emergency?<br/>trees trained on LinuxONE"]
      M3["M3 body match<br/>heartbeat vs pulse"]
      M4["M4 replay of own data?"]
      M5["M5 network attack?"]
      M6["M6 arterial-line drift<br/>vs cuff"]
    end

    DL["<b>Decision layer</b><br/>fixed precedence<br/>trust + up to 3 reasons"]
    V["<b>8 verdicts</b><br/>BOTH · EMERGENCY · TAMPERING<br/>DRIFTING · LOOSE_SENSOR<br/>DEVICE_ATTACK · UNSURE · NORMAL"]

    subgraph AG["Agents A1-A8"]
      direction LR
      A1["A1 alerts + 30 s ladder"]
      A2["A2 cut-off + Undo"]
      A3["A3 evidence, SHA-256"]
      A4["A4 fleet hunt"]
      A5["A5 CERT-In draft, 6 h clock"]
      A6["A6 biomed tickets"]
      A7["A7 nurse workload"]
      A8["A8 shift briefing<br/>IBM Granite on LinuxONE"]
    end

    API["<b>Backend API</b><br/>FastAPI + WebSocket<br/>PostgreSQL 16"]
  end

  TG["Telegram phone alerts<br/>bedside nurse"]
  SCR["<b>13 screens</b><br/>nurse · doctor · IT · biomed · demo"]

  MON -- "ward/bed/BNN/vitals" --> HUB
  ATK -. "same topics" .-> HUB
  HUB -- "broker log" --> NW
  NW -- "net/device/.../features (to M5)" --> BR
  HUB -- "vitals" --> BR
  BR -- "6 scores" --> DL
  DL --> V
  V -- "verdict per bed" --> AG
  V --> API
  AG -- "actions, alerts, records" --> API
  AG -- "A1 alert + ladder" --> TG
  AG -. "A2 cut off device / Undo" .-> HUB
  API -- "REST + /ws" --> SCR
  SCR -. "ack · Patient OK · Undo" .-> API

  classDef box fill:#eef4fb,stroke:#4a6f96,stroke-width:1.5px,color:#1d2b3a
  classDef outside fill:#ffffff,stroke:#7b8a99,stroke-width:1.5px,color:#1d2b3a
  classDef attack fill:#f4f4f4,stroke:#8a8a8a,stroke-dasharray:5 4,color:#444
  classDef emerg fill:#fdecea,stroke:#c0392b,stroke-width:2.5px,color:#7b1d14
  class HUB,NW,M1,M3,M4,M5,M6,DL,V,A2,A3,A4,A5,A6,A7,A8,API box
  class MON,SCR outside
  class ATK attack
  class M2,A1,TG emerg
  style Z fill:#f3f7fb,stroke:#1f4e79,stroke-width:2px,color:#1f4e79
  style BR fill:#ffffff,stroke:#9fb3c8
  style AG fill:#ffffff,stroke:#9fb3c8
  linkStyle 10 stroke:#c0392b,stroke-width:2.5px
