[Unit]
Description=SentinelWard finite attack schedule demo-control listener
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=linux1
Group=linux1
WorkingDirectory=/home/linux1/sw/app
EnvironmentFile=/home/linux1/sw/.env
Environment=SW_RUNS=/home/linux1/sw/runs/attacks
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/linux1/sw/.venv/bin/python /home/linux1/sw/app/deploy/service_env.py /home/linux1/sw/.venv/bin/python -m sw_attacks --runs-dir /home/linux1/sw/runs/attacks --schedule /home/linux1/sw/app/attacks/schedule.yaml
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
