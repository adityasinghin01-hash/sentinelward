[Unit]
Description=SentinelWard fresh agents (A1-A8)
After=network-online.target mosquitto.service sw-api.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@STATE_DIR@
EnvironmentFile=@ENV@
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV@/bin/python @APP@/security_v2/scripts/run_agents.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
UMask=0077

[Install]
WantedBy=multi-user.target
