[Unit]
Description=SentinelWard agents (LangGraph, A1-A8, optional research M6/Granite)
After=network-online.target postgresql.service mosquitto.service sw-api.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP@/agents
EnvironmentFile=@ENV@
Environment=PYTHONUNBUFFERED=1
Environment=PSYCOPG_IMPL=python
Environment=LANGSMITH_TRACING=false
ExecStart=@VENV@/bin/sentinelward serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
UMask=0077

[Install]
WantedBy=multi-user.target
