# SentinelWard agents v2 settings. Copy to /home/linux1/sw/agents2.env and chmod 0600.
# Every value is optional; the defaults below are what the service uses when a line is absent.
# JSON values: wrap the whole value in single quotes so systemd keeps the double quotes, e.g. SW_ROSTER='{"B01":"staff:priya"}'.
# Secrets (MQTT password, Telegram token) are never logged.

# ---- hub (falls back to SENTINEL_MQTT_* from security_v2's agents.env, then SW_MQTT_USER/PASS)
SW_AGENTS_MQTT_HOST=127.0.0.1
SW_AGENTS_MQTT_PORT=1883
# SW_AGENTS_MQTT_USERNAME=agents
# SW_AGENTS_MQTT_PASSWORD=
# SW_AGENTS_MQTT_CA=/home/linux1/sw/security-v2/ca.crt   # TLS (port 8883) only
SW_AGENTS_CLIENT_ID=sw-agents2
# Extra read-only topics kept in A3's evidence buffer ("none" to disable). The agents ACL allows M3/M5 scores.
SW_AGENTS_EXTRA_SUBS=ward/bed/+/score/M3,ward/bed/+/score/M5
SW_AGENTS_STATE_DIR=/home/linux1/sw/agents2-data
SW_TZ=Asia/Kolkata
SW_WARD_NAME=Ward 4B (demo)
SW_LOG_LEVEL=INFO

# ---- people (must match backend/users.yaml + ward.yaml)
SW_NURSES=staff:priya,staff:tom
SW_DOCTOR=staff:dr_mehta
SW_CHARGE_NURSE=staff:priya
# JSON bed -> nurse; default B01-B06 staff:priya, B07-B12 staff:tom
# SW_ROSTER='{"B01":"staff:priya"}'

# ---- A1 alerts and ladder
SW_A1_LADDER_STEP_S=30
SW_A1_LADDER_PRIORITIES=high,medium
# medium/low alerts need this many consecutive verdicts; NORMAL x this many closes a medium/low alert
SW_A1_CONFIRM_VERDICTS=2
SW_A1_CLEAR_VERDICTS=2
# UNSURE alone waits longer (6 verdicts = ~30 s) so a brief doubt does not page a nurse
SW_A1_UNSURE_CONFIRM_VERDICTS=6
# Telegram: empty token = "telegram off" (alerts still on ward/alert and the screens)
SW_TELEGRAM_BOT_TOKEN=
# staff -> chat ID, as a 0600 JSON file and/or inline JSON
SW_TELEGRAM_RECIPIENTS_FILE=
# SW_TELEGRAM_CHATS='{"staff:priya":123456789,"staff:tom":234567890,"staff:dr_mehta":345678901}'
# IT group chat for TAMPERING/BOTH/DEVICE_ATTACK notices
SW_TELEGRAM_IT_CHAT=
SW_TELEGRAM_MIN_INTERVAL_S=1

# ---- A2 containment (security_v2 Containment helper). Without SW_DYNSEC_OPTIONS: dry run.
SW_A2_MIN_CONFIDENCE=0.8
# TAMPERING/DEVICE_ATTACK: bed marked untrusted at once; hub cut-off only after the attack holds this many
# seconds of consecutive verdicts (a real alarm still gets through meanwhile). BOTH cuts off at once.
SW_A2_CONFIRM_S=20
SW_A2_DRY_RUN=false
# Set by security_v2 setup in its agents.env:
# SW_DYNSEC_OPTIONS=/home/linux1/sw/security-v2/admin.conf
# SW_CONTAIN_AUDIT=/home/linux1/sw/agents-data/containment.jsonl
# SW_MONITOR_CREDENTIALS=/home/linux1/sw/security-v2/devices.json   # enables session wipe
# Re-enable every device A2 cut off when the Demo reset button is pressed
SW_A2_RESET_RELEASES=true

# ---- A3 evidence
SW_A3_WINDOW_S=600

# ---- A4 fleet hunt: JSON MON-xx -> model (default: all twelve are "demo-monitor")
# SW_DEVICE_MODELS='{"MON-01":"demo-monitor"}'
SW_A4_WATCH_MINUTES=60
SW_A4_AFTER_CUTOFF=true

# ---- A5 CERT-In draft fields (empty = listed in missing_fields for a person to fill)
SW_ORG_NAME=
SW_REPORTER_NAME=
SW_REPORTER_EMAIL=
SW_REPORTER_PHONE=

# ---- A6 biomed tickets
SW_A6_LOOSE_REPEATS=3
SW_A6_LOOSE_WINDOW_S=600

# ---- A7 workload
SW_A7_THRESHOLD=40
SW_A7_WINDOW_S=7200
SW_A7_EVERY_S=60

# ---- A8 briefing (IBM Granite via deploy/granite; empty URL = template)
SW_SHIFT_START=08:00
SW_A8_EVERY_S=600
SW_A8_DEMO_AT_S=1140
SW_GRANITE_URL=http://127.0.0.1:8090
# Granite 350M on the LinuxONE CPU: ~4 tokens/s. A8 calls it on its own thread (nothing waits), asks for a
# short note and publishes the template first, rewriting the same briefing when Granite is done.
SW_GRANITE_TIMEOUT_S=120
SW_GRANITE_MAX_TOKENS=120
# ward script: start Granite this many seconds before T+19:00 (i.e. at T+18:00) so the briefing is ready on time
SW_A8_GRANITE_LEAD_S=60
