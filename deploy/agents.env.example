# Copy to ~/sw/agents.env (0600); installer creates it if missing.
# Keep the backend's ~/sw/.env separate. Never use its sentinelward/sw_api DSN here.
SENTINEL_TEAM_ENABLED=true
SENTINEL_ENVIRONMENT=demo
SENTINEL_DATABASE_URL=postgresql://sw_agents:CHANGE_ME@127.0.0.1:5432/sw_agents
SENTINEL_MQTT_HOST=127.0.0.1
SENTINEL_MQTT_PORT=1883
SENTINEL_MQTT_TLS=false
SENTINEL_MQTT_CLIENT_ID=sw-agents
SENTINEL_BACKEND_BASE_URL=http://127.0.0.1:8000
# Optional backend session bearer token reads current assignment via /api/beds/Bxx.
# Without it the explicit demo roster from backend/ward.yaml is used (B01-06 Priya, B07-12 Tom).
SENTINEL_BACKEND_SERVICE_TOKEN=
SENTINEL_HTTP_HOST=127.0.0.1
SENTINEL_HTTP_PORT=8088
SENTINEL_TEAM_STATE_DIR=@STATE_DIR@
SENTINEL_ALERT_DEMO_SECONDS=30
# Both optional: no token/chat map means MQTT screen alerts + ladder still work.
SENTINEL_TELEGRAM_BOT_TOKEN=
# JSON staff IDs -> integer chat IDs, chmod 0600; see deploy/AGENTS.md.
SENTINEL_TELEGRAM_RECIPIENTS_FILE=
# Optional local OpenAI-compatible writer, existing verified fact/template fallback.
SENTINEL_GRANITE_URL=
SENTINEL_GRANITE_MODEL=granite
SENTINEL_GRANITE_MODEL_SHA256=
SENTINEL_GRANITE_API_KEY=
# Research M6 requires reviewed episode contexts; brain already supplies its M6.
SENTINEL_M6_ENABLED=false
SENTINEL_M6_CONTEXTS_FILE=
SENTINEL_M6_CALIBRATION_FILE=
SENTINEL_DEMO_LIFECYCLE_ENABLED=false
SENTINEL_EXTERNAL_EFFECT_MODE=simulate
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
PSYCOPG_IMPL=python
