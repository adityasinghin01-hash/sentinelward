# Create ~/sw/agents.env with mode 0600. Never reuse old SENTINEL_* settings.
# Use the hub-issued agents account. security_v2 setup adds a private env drop-in.
SW_MQTT_HOST=127.0.0.1
SW_MQTT_PORT=1883
SW_MQTT_USER=agents
SW_MQTT_PASS=
# Containment paths are supplied by security_v2 setup; never put secrets in argv.
SW_DYNSEC_OPTIONS=/home/linux1/sw/security-v2/admin.conf
SW_CONTAIN_AUDIT=/home/linux1/sw/agents-data/containment.jsonl
SW_MONITOR_CREDENTIALS=/home/linux1/sw/security-v2/devices.json
# Optional fact-only briefing writer.
SW_GRANITE_URL=
# Check agents_v2's env example after merging for Telegram, timing and state settings.
